# This file contains the environment variables needed for the Skeptical Wombat application.
# Copy this file to .env and fill in the values.

# Supabase project URL and anon (public) key — from Project Settings > API.
# The anon key is safe to expose client-side; it's constrained by the RLS
# policies in supabase/migrations/0001_init.sql, not by secrecy.
#
# Before this works: run supabase/migrations/0001_init.sql against your
# project, AND enable Anonymous Sign-Ins under Authentication > Providers —
# it's off by default on new projects, and this app only supports anonymous
# auth right now, so sign-in fails with no user profile until it's turned on.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Your Google Gemini API Key
# TODO(SEC-01): this is still read client-side in src/services/ai.ts and
# exposed in the bundle. Move Gemini calls behind a backend/serverless proxy
# before shipping — see ROADMAP_2026-04-27.md.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: opt into the LangChain call path in src/services/ai.ts
# VITE_USE_LANGCHAIN="true"
