{
  "name": "steelman-skeptical-wombat",
  "version": "1.0.0",
  "description": "A web application that helps partners navigate disagreements with blunt, witty AI-driven analysis",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^0.3.75",
    "@langchain/google-genai": "^0.2.17",
    "@supabase/supabase-js": "^2.45.4",
    "langchain": "^0.3.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.19.14",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^24.1.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "react",
    "typescript",
    "ai",
    "relationships",
    "conflict-resolution"
  ],
  "author": "Phazzie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phazzie/SteelmanSkepticalWombat.git"
  }
}
